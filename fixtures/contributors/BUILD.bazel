"""contributors fixture — Bazel battery-tier port (pilot).

Same proven shape as fixtures/breakout (see that BUILD file for the
full rationale): playtest-enabled binary + battery test, unmodified
committed tests/playtest.rs, $(rootpath)-baked CARGO_BIN_EXE_*,
assets via runfiles + the harness's cwd symlink-tree isolation.
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "crate_deps")

HARNESS = "//:bevy_playtest_harness"

DEPS = crate_deps(
    [
        "bevy",
        "chacha20",
        "rand",
        "thiserror",
    ],
    package_name = "bazel-support",
)

rust_binary(
    name = "fixture_contributors_playtest",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    crate_name = "fixture_contributors",
    # The feature-gated playtest transform (fetch_bevy_examples.sh):
    # playtest builds swap in PlaytestDefaultPlugins + PlaytestPlugin;
    # plain builds carry ZERO bevy_playtest code.
    crate_features = ["playtest"],
    compile_data = [
        "Cargo.toml",
        "//fixtures:Cargo.lock",
    ],
    deps = DEPS + [HARNESS],
    rustc_env = {
        "CARGO_PKG_VERSION": "0.1.0",
        "CARGO_PKG_NAME": "fixture_contributors",
    },
    data = [":assets"],
    visibility = ["//visibility:private"],
)

rust_test(
    name = "playtest_battery",
    # medium's 300s deadline is too tight for CI runners on software
    # Vulkan (llvmpipe): locally alien_cake_addict already runs ~105s
    # on a real GPU. large grants 900s.
    size = "large",
    srcs = ["tests/playtest.rs"],
    edition = "2024",
    crate_name = "playtest_test_fixture_contributors",
    # #[cfg(feature = "playtest")] gates the real battery in the
    # committed test; without this the vacuous #[ignore] stub compiles
    # instead and the target passes without testing anything.
        crate_features = ["playtest"],
    # The harness's zero-config source scan (discovery/source_scan.rs
    # scan_root_from_env) keys off runtime CARGO_MANIFEST_DIR under
    # cargo; under Bazel that env var points at the execroot sandbox,
    # so we use the harness's OWN override (ENV_SOURCE_ROOT —
    # checked at battery-parent scope, so the BEVY_PLAYTEST_* strip
    # the battery applies to spawned children doesn't affect it).
    # Value: package-relative path, resolved against the test cwd
    # (the runfiles workspace root). Sources arrive in runfiles via
    # the :fixture_sources data dep below.
    env = {
        "BEVY_PLAYTEST_SOURCE_ROOT": "fixtures/contributors",
        # PATH shadows git with an executable STUB (genrule below)
        # printing the same pinned author trio as the seeded cargo
        # -tier .git (scripts/fetch_bevy_examples.sh step 7).
        # Why a stub and not a real repo: runfiles are a symlink
        # farm and git rejects symlinked .git transports, so no
        # usable .git can reach the game child. Why non-empty
        # output instead of failing: upstream turns a *successful*
        # empty `git log` into an EMPTY list (boot panic); only
        # genuine spawn/IO failure reaches its fallback list — and
        # execvp skips non-executable PATH matches, so a broken
        # stub silently falls through to the host's real git (the
        # exact flakiness this tier must not have). The stub is
        # deterministic, host-independent, and matches the cargo
        # tier's seeded history content. Real system dirs stay on
        # PATH (Bazel's own test wrapper needs bash); the game
        # child's PATH entry. The game invokes git with
        # current_dir(CARGO_MANIFEST_DIR) — a runfiles-relative path —
        # and POSIX PATH search happens AFTER that chdir, so the
        # entry resolves against fixtures/contributors, where
        # git-stub-dir lives (verified empirically on macOS; the
        # leading `.:` rules_rust prepends then resolves harmlessly).
        # The stub matches on `$*` containing "log" — the game's
        # first argument is `--no-pager`, so a `$1`-based match
        # would silently miss.
        "PATH": "git-stub-dir:/usr/bin:/bin",
    },
    compile_data = [
        "Cargo.toml",
        "//fixtures:Cargo.lock",
    ],
    deps = [HARNESS],
    rustc_env = {
        # $(rootpath), NOT $(location)/$(rlocationpath): see
        # fixtures/breakout/BUILD.bazel for the empirical path-shape
        # notes.
        "CARGO_BIN_EXE_fixture_contributors": "$(rootpath :fixture_contributors_playtest)",
    },
    data = [
        ":fixture_contributors_playtest",
        ":assets",
        # Game sources in runfiles: the harness's zero-config source
        # scan reads them via BEVY_PLAYTEST_SOURCE_ROOT (see the env
        # block above). Note: the game's `git log` (upstream
        # showcase behavior) intentionally gets the FALLBACK path
        # here — runtime CARGO_MANIFEST_DIR is unset under Bazel, so
        # `std::env::var(...)?` errs and upstream's own
        # `contributors_or_fallback()` ships its default list: the
        # same deterministic, host-independent path as
        # bevy_ci_testing. (Under cargo the seeded fixture .git from
        # scripts/fetch_bevy_examples.sh serves that role instead —
        # runfiles symlink farms can't transport a .git, git rejects
        # them.)
        ":fixture_sources",
        ":git_stub",
    ],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "assets",
    srcs = glob(["assets/**"]),
    visibility = ["//visibility:public"],
)

# Executable `git` stub for the PATH entry above (see the env
# block's rationale): prints the pinned author trio — one name per
# line, exactly what `git --no-pager log --pretty=format:%an` emits
# for the seeded cargo-tier fixture repo. Deterministic across
# machines and CI.
genrule(
    name = "git_stub",
    outs = ["git-stub-dir/git"],
    cmd = "printf '#!/bin/sh\ncase \"$$*\" in\n  *log*) printf \"Carol Contributor\nBob Builder\nAlice Author\n\" ;;\n  *) exit 0 ;;\nesac\n' > $@ && chmod +x $@",
    visibility = ["//visibility:private"],
)



filegroup(
    name = "fixture_sources",
    srcs = glob(["src/**"]),
    visibility = ["//visibility:public"],
)