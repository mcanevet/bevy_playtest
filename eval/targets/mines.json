{
  "fixture": "mines",
  "manifest_dir": "fixtures/mines",
  "targets": [
    {
      "id": "M1",
      "description": "Start a game (Playing)",
      "check": {
        "entered": [
          "OnEnter(Playing)"
        ]
      }
    },
    {
      "id": "M2",
      "description": "Reveal ~10 tiles: Game written >= 11 times (1 new-game click + 10 tile reveals; extra new-game clicks also count)",
      "check": {
        "resource_changed_times": {
          "resource": "Game",
          "at_least": 11
        }
      }
    },
    {
      "id": "M3",
      "description": "Reveal at least one tile (Game written again after the new-game click)",
      "check": {
        "resource_changed_times": {
          "resource": "Game",
          "at_least": 2
        }
      }
    },
    {
      "id": "M4",
      "description": "Return to the menu after playing",
      "check": {
        "entered_times": {
          "label": "OnEnter(Menu)",
          "at_least": 2
        }
      }
    },
    {
      "id": "M5",
      "description": "Start three games (difficulty itself is not visible)",
      "check": {
        "entered_times": {
          "label": "OnEnter(Playing)",
          "at_least": 3
        }
      }
    }
  ]
}
