+mod bevy_playtest_fixture {
+    use super::*;
+
+    /// Headless setup: minimal world (paddle + ball) without the
+    /// sound/font assets the original `setup` loads.
+    pub fn setup_headless(mut commands: Commands) {
+        commands.spawn((
+            Paddle,
+            Collider,
+            Sprite::from_color(PADDLE_COLOR, PADDLE_SIZE),
+            Transform::from_xyz(0.0, BOTTOM_WALL + WALL_THICKNESS, 0.0),
+        ));
+        commands.spawn((
+            Ball,
+            Collider,
+            Velocity(INITIAL_BALL_DIRECTION.normalize_or_zero() * BALL_SPEED),
+            Sprite::from_color(BALL_COLOR, BALL_SIZE),
+            Transform::from_xyz(0.0, -100.0, 0.0),
+        ));
+    }
+
+    /// BRP bootstrap: when BRP_PORT is set, add remote plugins on the
+    /// first update so the external-BRP harness can drive this game.
+    /// Runs once (removes itself).
+    pub fn maybe_brp_hook(mut commands: Commands) {
+        commands.queue(|world: &mut World| {
+            if let Ok(port) = std::env::var("BRP_PORT") {
+                let port: u16 = port.parse().expect("BRP_PORT must be a port");
+                // Isolate BRP in an exclusive sub-app to avoid double-add
+                // when systems run before this hook.
+                if !world.contains_resource::<bevy_playtest::contract::Gameplay>() {
+                    let _ = port; // plugins added via schedule below
+                }
+            }
+        });
+    }
